{
  "name": "openfriend",
  "version": "0.0.0",
  "private": true,
  "description": "A full-duplex personal companion for Apple Watch and the web.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @openfriend/web dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm -r --parallel --if-present test:watch",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "docs:check": "node scripts/check-docs.mjs",
    "verify": "pnpm test && pnpm typecheck && pnpm lint && pnpm format:check && pnpm docs:check && pnpm build"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
